# Copy to .env for local development. On Hugging Face, set these under Settings -> Secrets.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=          # optional: backup when Groq is rate-limited

# Optional overrides
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-2.0-flash
# RERANK=false
# MIN_SIMILARITY=0.45
# TOP_K=5

# Only for scripts/compare_parsers.py (LlamaParse cloud parser)
LLAMA_CLOUD_API_KEY=
